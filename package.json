{
  "name": "myfoodapp-sample-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "API integration and testing app for the My Food App API (talks to it only over HTTP).",
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write src tests e2e/tests \"*.ts\" \"*.js\" \"*.json\"",
    "format:check": "prettier --check src tests e2e/tests \"*.ts\" \"*.js\" \"*.json\"",
    "test:unit": "vitest run --project unit",
    "test:api": "vitest run --project api",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test:unit"
  },
  "dependencies": {
    "@tanstack/react-query": "5.107.1",
    "@zxing/browser": "0.2.1",
    "@zxing/library": "0.23.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.8",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
