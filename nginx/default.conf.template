# Rendered by the nginx image at start-up (envsubst): ${API_BASE_URL} comes
# from the container environment, e.g. http://api:9595 on the backend's
# Docker network. The browser only ever talks to this server; /api/* is
# forwarded to the API, so no CORS change is needed in the backend.

server {
  listen 80;
  server_name _;
  root /usr/share/nginx/html;

  # resolve the API's service name at request time (Docker's DNS), so this
  # container starts even when the backend is down and follows API restarts
  resolver 127.0.0.11 valid=10s ipv6=off;
  set $api_base ${API_BASE_URL};

  client_max_body_size 12m;

  location = /healthz {
    default_type text/plain;
    return 200 "ok\n";
  }

  location /api/ {
    rewrite ^/api/(.*)$ /$1 break;
    proxy_pass $api_base;
    proxy_http_version 1.1;
    proxy_set_header Host $proxy_host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    # unknown barcodes wait for Open Food Facts + the AI fallback; OCR up to 30 s
    proxy_read_timeout 90s;
    proxy_intercept_errors off;
  }

  location /assets/ {
    expires 1y;
    add_header Cache-Control "public, immutable";
    try_files $uri =404;
  }

  location / {
    add_header Cache-Control "no-cache";
    try_files $uri /index.html;
  }
}
